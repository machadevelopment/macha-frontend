NEXT_PUBLIC_APP_NAME=Macha Finance
# Backend base URL (macha-backend on Railway)
NEXT_PUBLIC_API_URL=http://localhost:3001
# WorkOS AuthKit (hosted UI; app only verifies session)
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3000/callback
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
WORKOS_COOKIE_PASSWORD=

# --- Sentry ---
# No-op sin DSN real — local/dev/CI nunca los setean. Solo Vercel staging/prod.
# Son DOS variables porque son dos lados: NEXT_PUBLIC_* llega al navegador (errores de
# render), la otra se queda en servidor/edge (Server Components, route handlers,
# middleware). Faltar una deja media aplicación sin monitoreo. Ver README §Observabilidad.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=

# CU-868kmr1tb — opcionales: etiqueta del entorno en cada evento. Si no se setean se usa
# VERCEL_ENV / NEXT_PUBLIC_VERCEL_ENV, que inyecta la plataforma ('production' /
# 'preview' / 'development'). NO se usa NODE_ENV como fuente: en Vercel un deploy de
# preview también compila con NODE_ENV=production, así que etiquetaría cada PR como
# producción. Ver lib/sentry-environment.ts.
SENTRY_ENVIRONMENT=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=

# CU-868kjc99f — subida de source maps (solo build time, nunca en el bundle).
# Sin SENTRY_AUTH_TOKEN el plugin omite la subida y el build sigue en verde: por eso CI
# no necesita secretos. Se setean SOLO en Vercel y POR ENTORNO — staging y prod usan
# proyectos distintos (regla no negociable: credenciales de no-prod separadas).
# El token es de escritura: va en Vercel, jamás en el repo ni en .env.local.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
